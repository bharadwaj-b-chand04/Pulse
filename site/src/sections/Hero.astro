---
import { stats } from "../data/facts";
import Screenshot from "../components/Screenshot.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="hero" aria-labelledby="hero-title">
  <svg class="hero__trace" viewBox="0 0 1200 160" preserveAspectRatio="none" aria-hidden="true">
    <path
      data-hero-trace
      d="M0 110 H180 l10 -8 l8 8 H260 l6 6 l16 -86 l14 110 l10 -30 H360 q18 -26 36 0 H560 l10 -8 l8 8 H640 l6 6 l16 -86 l14 110 l10 -30 H740 q18 -26 36 0 H1200"
    />
  </svg>

  <div class="hero__grid">
    <div class="hero__copy">
      <h1 id="hero-title" class="hero__title" data-hero-title>Your medical history, owned by you.</h1>
      <p class="hero__lede" data-hero-fade>
        Pulse is a lifelong electronic health record. Providers add to it. Clinicians read it only with the
        patient's consent. Every access is written to a log the patient can read, and nobody can rewrite.
      </p>
      <div class="hero__actions" data-hero-fade>
        <a class="btn btn-primary" href="#story">Follow the story</a>
        <a class="btn" href={`${base}/guide/`}>Open the guide</a>
      </div>
      <p class="hero__facts" data-hero-fade>
        {stats.endpoints} endpoints, each declaring the permission it needs. {stats.adrs} architecture decisions,
        written down. {stats.locales} languages. Zero real patients.
      </p>
    </div>

    <figure class="hero__record glass" aria-label="Illustration: a patient timeline and its access log">
      <figcaption class="hero__record-head">
        <span>Aishani's timeline</span>
        <span class="hero__muted">synthetic patient</span>
      </figcaption>
      <ol class="entries" data-hero-entries>
        <li class="entry">
          <span class="entry__kind">Lab report</span>
          <span class="entry__main">HbA1c <strong>7.9 %</strong></span>
          <span class="flag flag--high">
            <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path d="M8 3l5 9H3z" fill="currentColor" /></svg>
            High, above 5.7
          </span>
        </li>
        <li class="entry">
          <span class="entry__kind">Prescription</span>
          <span class="entry__main">Metformin 500 mg, twice daily</span>
        </li>
        <li class="entry">
          <span class="entry__kind">Diagnosis</span>
          <span class="entry__main">Type 2 diabetes mellitus</span>
          <span class="entry__code">SNOMED CT 44054006</span>
        </li>
      </ol>
      <div class="access" data-hero-access>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" />
        </svg>
        <span><strong>Dr. Rao viewed 3 entries</strong> inside an active consent. Recorded in the audit log.</span>
      </div>
    </figure>
  </div>
  <details class="hero__app">
    <summary>See the actual app in light and dark</summary>
    <p>Captured from the local synthetic demo. The story uses the same burgundy theme and Noto typeface.</p>
    <div class="hero__captures">
      <div><h3>Light interface</h3><Screenshot name="home-desktop" alt="The real Pulse public entry page in its light burgundy theme" url="/en" /></div>
      <div><h3>Dark interface</h3><Screenshot name="home-desktop-dark" alt="The real Pulse public entry page in its dark burgundy theme" url="/en" /></div>
    </div>
  </details>
</section>

<style>
  .hero {
    position: relative;
    padding: clamp(3.5rem, 9vw, 7rem) var(--gutter) 2rem var(--content-start);
    max-width: calc(var(--wide) + var(--content-start) + var(--gutter));
    margin: 0 auto;
    min-height: min(92svh, 860px);
  }
  .hero__trace {
    position: absolute;
    left: 0;
    right: 0;
    top: clamp(1rem, 4vw, 2.5rem);
    width: 100%;
    height: 120px;
    overflow: visible;
    opacity: 0.55;
  }
  .hero__app { margin-top: 2rem; border-block: 1px solid var(--border); padding-block: 0.8rem; }
  .hero__app summary { min-height: 44px; align-content: center; cursor: pointer; font-weight: 500; }
  .hero__app > p { font-size: 0.92rem; color: var(--muted-foreground); margin-block: 0.5rem 1.25rem; }
  .hero__captures { display: grid; gap: 1.25rem; }
  .hero__captures h3 { font-size: 1rem; margin-bottom: 0.75rem; }
  @media (min-width: 900px) { .hero__captures { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .hero__trace path {
    fill: none;
    stroke: var(--primary);
    stroke-width: 2;
    vector-effect: non-scaling-stroke;
    stroke-linejoin: round;
  }
  .hero__grid {
    position: relative;
    display: grid;
    gap: 3rem;
    align-items: center;
    padding-top: 5rem;
  }
  @media (min-width: 1000px) {
    .hero__grid { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 4rem; }
  }
  .hero__title {
    font-size: var(--step-5);
    letter-spacing: -0.035em;
    line-height: 1.02;
    max-width: 13ch;
  }
  .hero__lede {
    margin-top: 1.6rem;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--muted-foreground);
    max-width: 36ch;
  }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .hero__facts {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
    color: var(--muted-foreground);
    font-size: 0.95rem;
    max-width: 52ch;
  }

  .hero__record {
    border-radius: calc(var(--radius) * 1.8);
    padding: 1.25rem;
    max-width: 480px;
    width: 100%;
    justify-self: center;
  }
  .hero__record-head {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-weight: 700;
    padding: 0.25rem 0.25rem 1rem;
  }
  .hero__muted { color: var(--muted-foreground); font-weight: 400; font-size: 0.85rem; }
  .entries { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  .entry {
    display: grid;
    gap: 0.15rem;
    padding: 0.85rem 1rem;
    border-radius: var(--radius);
    background: var(--card);
    border: 1px solid var(--border);
  }
  .entry__kind { font-size: 0.78rem; color: var(--primary); font-weight: 500; }
  .entry__main { font-weight: 500; }
  .entry__code { font-size: 0.8rem; color: var(--muted-foreground); }
  .flag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    width: fit-content;
    margin-top: 0.25rem;
    padding: 0.1rem 0.55rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 500;
  }
  .flag--high { color: var(--critical); background: var(--critical-surface); }
  .access {
    display: flex;
    gap: 0.7rem;
    align-items: flex-start;
    margin-top: 0.9rem;
    padding: 0.85rem 1rem;
    border-radius: var(--radius);
    background: var(--consent-active-surface);
    color: var(--consent-active);
    font-size: 0.9rem;
    line-height: 1.45;
  }
  .access svg { flex: none; margin-top: 0.1rem; }
</style>

<script>
  import { gsap, reducedMotion } from "../scripts/motion";

  // The page's one orchestrated moment: the trace draws, the claim lands,
  // the record fills, and the access is written down.
  if (!reducedMotion()) {
    const trace = document.querySelector<SVGPathElement>("[data-hero-trace]");
    const len = trace?.getTotalLength() ?? 0;
    const tl = gsap.timeline({ defaults: { ease: "power3.out" } });
    if (trace) {
      gsap.set(trace, { strokeDasharray: len, strokeDashoffset: len });
      tl.to(trace, { strokeDashoffset: 0, duration: 1.6, ease: "power2.inOut" }, 0);
    }
    // Keep the heading and explanation readable at first paint. The trace and
    // record carry the entrance animation without delaying the main text.
    tl.from("[data-hero-entries] > li", { x: 24, opacity: 0, duration: 0.6, stagger: 0.14 }, 0.7)
      .from("[data-hero-access]", { y: 12, opacity: 0, scale: 0.98, duration: 0.6 }, 1.35);
  }
</script>
