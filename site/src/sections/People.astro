---
import Chapter from "../components/Chapter.astro";
import CodeBlock from "../components/CodeBlock.astro";
import { blob, roles, stats } from "../data/facts";
import { permissionGroups, roleColumns, routeCoverage } from "../data/story-a";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const flat = permissionGroups.flatMap((g) => g.items);
const held = (role: string) => flat.map((p) => (p.held).includes(role));

// The page must not drift from facts.ts: fail the build if a count disagrees.
if (flat.length !== stats.permissions) throw new Error(`permissions: ${flat.length} != ${stats.permissions}`);
for (const r of roles) {
  const n = held(r.id).filter(Boolean).length;
  if (n !== r.permissions) throw new Error(`${r.id}: matrix has ${n}, facts.ts says ${r.permissions}`);
}

const excerpt = `
def _walk(dependant: Dependant) -> Iterator[object]:
    """Yield every \`.call\` in the dependency tree, depth-first."""
    for sub in dependant.dependencies:
        if sub.call is not None:
            yield sub.call
        yield from _walk(sub)


def _declares_marker(route: APIRoute) -> bool:
    return any(
        hasattr(call, PERMISSION_ATTR) or hasattr(call, PUBLIC_ATTR)
        for call in _walk(route.dependant)
    )
`;
---

<Chapter
  id="people"
  n={3}
  title="Four roles, and what each one cannot do"
  lede="Who a person is decides which of sixteen permissions they hold. The list is closed and the mapping lives in one short file, so the answer to 'can a Clinician do this' is a lookup, not an investigation."
  wide
>
  <p class="ppl__intro">
    Roles are <code>PATIENT</code>, <code>PROVIDER_STAFF</code>, <code>CLINICIAN</code> and <code>ADMINISTRATOR</code>. <code>Permission</code> is an enum of {stats.permissions} members, and <code>ROLE_PERMISSIONS</code> is a plain table
    from role to a frozen set of them, resolved without a database or a request. It is all in <a href={blob("backend/app/core/authz.py")}>backend/app/core/authz.py</a>. Pick a role to see its column.
  </p>

  <div class="ppl" data-people data-role="PATIENT">
    <div class="ppl__switch" role="group" aria-label="Choose a role">
      {roles.map((r, i) => (
        <button type="button" class="pick" data-pick={r.id} aria-pressed={i === 0 ? "true" : "false"}>
          <span class="pick__name">{r.name}</span>
          <span class="pick__n">{r.permissions} of {stats.permissions}</span>
        </button>
      ))}
    </div>

    <div class="ppl__panel" aria-live="polite">
      {roles.map((r, i) => (
        <div class="panel" data-panel={r.id} hidden={i !== 0}>
          <h3>{r.name}</h3>
          <p class="panel__pips">
            <span class="pips" aria-hidden="true">
              {held(r.id).map((h) => <i class:list={["pip", { "pip--on": h }]}></i>)}
            </span>
            <span>Holds {r.permissions} of {stats.permissions} permissions</span>
          </p>
          <p class="panel__can">
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="currentColor" /><path d="M4.6 8.2l2.3 2.3 4.5-4.7" fill="none" stroke="var(--card)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
            <span><strong>Can.</strong> {r.owns}</span>
          </p>
          <p class="panel__cannot">
            <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><circle cx="8" cy="8" r="6.2" fill="none" stroke="currentColor" stroke-width="1.6" /><path d="M4.6 11.4l6.8-6.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
            <span><strong>Cannot, or only within limits.</strong> {r.cannot}</span>
          </p>
        </div>
      ))}
    </div>

    <div class="ppl__matrix">
      <table class="matrix">
        <caption class="sr-only">Which role holds which permission. The chosen role's column is highlighted.</caption>
        <thead>
          <tr>
            <th scope="col" class="matrix__perm">Permission</th>
            {roleColumns.map((c) => <th scope="col" data-r={c.id}>{c.short}</th>)}
          </tr>
        </thead>
        {permissionGroups.map((g) => (
          <tbody>
            <tr class="grp"><th scope="colgroup" colspan="5">{g.group}</th></tr>
            {g.items.map((p) => (
              <tr>
                <th scope="row" class="matrix__perm">
                  <span class="perm__label">{p.label}</span>
                  <code class="perm__id">{p.id}</code>
                </th>
                {roleColumns.map((c) => {
                  const on = (p.held).includes(c.id);
                  return (
                    <td data-r={c.id}>
                      {on ? (
                        <svg class="mark mark--on" viewBox="0 0 16 16" width="18" height="18" role="img" aria-label="Held"><circle cx="8" cy="8" r="7" fill="currentColor" /><path d="M4.6 8.2l2.3 2.3 4.5-4.7" fill="none" stroke="var(--card)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                      ) : (
                        <svg class="mark mark--off" viewBox="0 0 16 16" width="18" height="18" role="img" aria-label="Not held"><path d="M4.5 8h7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
                      )}
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        ))}
      </table>
    </div>
  </div>

  <div class="gate">
    <div class="gate__text">
      <h3>A new endpoint cannot ship without saying who may call it</h3>
      <p>
        Holding <code>RECORDS_READ</code> answers whether a Clinician may read records at all. It never answers whether
        this Clinician may read this Patient's. That second question is the consent filter in <a href="#consent-engine">the consent engine chapter</a>. The permission table is the coarse first gate.
      </p>
      <p>
        {routeCoverage.declared} of the {stats.endpoints} endpoints declare either <code>requires(PERMISSION)</code> or
        an explicit <code>public()</code> marker. The other one, <code>{routeCoverage.allowlisted}</code>, is a liveness
        probe named in an allowlist inside the test. The test walks every route's dependency tree and fails if one has
        neither, so the usual failure, an endpoint added late at night with no check at all, turns the build red instead
        of returning someone's records. A second test proves the check bites by running it on a router that is
        deliberately undeclared.
      </p>
      <p class="gate__links">
        <a href={`${base}/guide/adr/0004-default-deny-route-authorization`}>ADR-0004</a>
        <a href={blob(routeCoverage.testPath)}>{routeCoverage.testPath}</a>
      </p>
    </div>
    <CodeBlock code={excerpt} lang="python" file={routeCoverage.testPath} lines="52-64" />
  </div>
</Chapter>

<style>
  .ppl__intro { max-width: 68ch; }
  .ppl { margin-top: 2rem; display: grid; gap: 1.5rem; }

  .ppl__switch { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem; }
  @media (min-width: 700px) { .ppl__switch { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .pick {
    display: grid;
    gap: 0.1rem;
    min-height: 56px;
    padding: 0.55rem 1rem;
    text-align: left;
    font: inherit;
    color: var(--foreground);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    cursor: pointer;
    transition: background-color 160ms, border-color 160ms;
  }
  .pick:hover { border-color: var(--primary); }
  .pick__name { font-weight: 700; }
  .pick__n { font-size: 0.85rem; color: var(--muted-foreground); }
  .pick[aria-pressed="true"] { background: var(--primary); color: var(--primary-foreground); border-color: transparent; }
  .pick[aria-pressed="true"] .pick__n { color: inherit; opacity: 0.85; }

  .panel[hidden] { display: none; }
  :global(html:not(.js)) .panel[hidden] { display: block; }
  :global(html:not(.js)) .ppl__switch { display: none; }
  .panel { display: grid; gap: 0.9rem; }
  .panel h3 { font-size: var(--step-2); }
  .panel__pips { display: flex; align-items: center; gap: 0.75rem; flex-wrap: wrap; font-size: 0.92rem; color: var(--muted-foreground); }
  .pips { display: grid; grid-template-columns: repeat(16, 9px); gap: 3px; }
  .pip { width: 9px; height: 16px; border-radius: 2px; border: 1.5px solid var(--muted-foreground); opacity: 0.55; }
  .pip--on { background: var(--primary); border-color: var(--primary); opacity: 1; }
  .panel__can, .panel__cannot { display: grid; grid-template-columns: 18px minmax(0, 1fr); gap: 0.65rem; align-items: start; }
  .panel__can svg, .panel__cannot svg { margin-top: 0.3rem; }
  .panel__can svg { color: var(--primary); }
  .panel__cannot {
    padding: 0.8rem 1rem;
    border-radius: var(--radius);
    background: var(--muted);
    border: 1px dashed var(--muted-foreground);
  }
  .panel__cannot svg { color: var(--foreground); }

  .ppl__matrix { overflow-x: auto; margin-inline: calc(var(--gutter) * -0.5); padding-inline: calc(var(--gutter) * 0.5); }
  .matrix { width: 100%; border-collapse: separate; border-spacing: 0; font-size: 0.9rem; }
  .matrix th, .matrix td { padding: 0.5rem 0.4rem; text-align: center; border-bottom: 1px solid var(--border); }
  .matrix thead th { font-size: 0.8rem; font-weight: 700; vertical-align: bottom; border-bottom: 2px solid var(--border); }
  .matrix .matrix__perm { text-align: left; font-weight: 400; padding-left: 0; }
  .perm__label { display: block; line-height: 1.3; }
  .perm__id { display: block; margin-top: 0.15rem; font-size: 0.66rem; color: var(--muted-foreground); background: none; border: 0; padding: 0; overflow-wrap: anywhere; }
  .grp th { text-align: left; padding: 1.1rem 0 0.35rem; font-size: 0.82rem; font-weight: 700; color: var(--primary); border-bottom: 0; }
  .matrix tbody tr:last-child th, .matrix tbody tr:last-child td { border-bottom: 1px solid var(--border); }
  .mark { margin-inline: auto; }
  .mark--on { color: var(--primary); }
  .mark--off { color: var(--muted-foreground); opacity: 0.6; }
  .matrix td, .matrix thead th[data-r] { width: 2.85rem; transition: background-color 200ms, opacity 200ms; }
  .matrix thead th[data-r] { font-size: 0.7rem; padding-inline: 0.1rem; }
  @media (min-width: 700px) { .matrix thead th[data-r] { font-size: 0.8rem; padding-inline: 0.4rem; } }
  @media (min-width: 700px) { .matrix td, .matrix thead th[data-r] { width: 5.5rem; } .matrix { font-size: 0.95rem; } .perm__id { font-size: 0.72rem; } }

  /* The chosen role's column is lifted: tinted, bold header, marks at full strength. The others recede. */
  .matrix td[data-r], .matrix thead th[data-r] { opacity: 0.5; }
  [data-role="PATIENT"] [data-r="PATIENT"],
  [data-role="PROVIDER_STAFF"] [data-r="PROVIDER_STAFF"],
  [data-role="CLINICIAN"] [data-r="CLINICIAN"],
  [data-role="ADMINISTRATOR"] [data-r="ADMINISTRATOR"] { opacity: 1 !important; background: var(--primary-soft); }
  [data-role="PATIENT"] thead [data-r="PATIENT"],
  [data-role="PROVIDER_STAFF"] thead [data-r="PROVIDER_STAFF"],
  [data-role="CLINICIAN"] thead [data-r="CLINICIAN"],
  [data-role="ADMINISTRATOR"] thead [data-r="ADMINISTRATOR"] { border-bottom: 3px solid var(--primary); color: var(--primary); }

  @media (min-width: 1000px) {
    .ppl { grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); column-gap: 3.5rem; align-items: start; }
    .ppl__switch { grid-column: 1 / -1; }
    .ppl__matrix { grid-column: 1; grid-row: 2; }
    .ppl__panel { grid-column: 2; grid-row: 2; position: sticky; top: 96px; }
  }

  .gate { margin-top: clamp(4rem, 8vw, 7rem); padding-top: 2.5rem; border-top: 1px solid var(--border); display: grid; gap: 2rem; }
  @media (min-width: 1000px) { .gate { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 3.5rem; align-items: start; } }
  .gate h3 { font-size: var(--step-2); margin-bottom: 1rem; }
  .gate p + p { margin-top: 0.9em; }
  .gate__text p { color: var(--muted-foreground); }
  .gate__links { display: flex; flex-wrap: wrap; gap: 0.4rem 1.25rem; font-size: 0.95rem; }
</style>

<script>
  // Picking a role only re-highlights; every column is always in the DOM.
  const root = document.querySelector<HTMLElement>("[data-people]");
  if (root) {
    const picks = [...root.querySelectorAll<HTMLButtonElement>("[data-pick]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-panel]")];
    picks.forEach((b) =>
      b.addEventListener("click", () => {
        const id = b.dataset.pick!;
        root.dataset.role = id;
        picks.forEach((p) => p.setAttribute("aria-pressed", String(p === b)));
        panels.forEach((p) => (p.hidden = p.dataset.panel !== id));
      }),
    );
  }
</script>
