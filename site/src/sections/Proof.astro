---
import Chapter from "../components/Chapter.astro";
import CodeBlock from "../components/CodeBlock.astro";
import { sourceExcerpt } from "../lib/source";
import { stats, blob } from "../data/facts";
import { ciJobs, liveSpine } from "../data/story-e";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const badRouter = `
router = APIRouter()


@router.get("/api/v1/deliberately-undeclared")
async def undeclared() -> dict[str, str]:
    return {"status": "undeclared"}
`;

const biteTest = `
def test_coverage_check_bites_on_an_undeclared_route() -> None:
    """Positive case: a router with a deliberately undeclared route must be
    reported by the same check."""
    ...
    throwaway = FastAPI()
    throwaway.include_router(module.router)

    offending = _undeclared(throwaway)
    assert offending == ["GET /api/v1/deliberately-undeclared"]
`;

const revokeTest = sourceExcerpt("backend/tests/test_architecture_regressions.py", 79, 101);

const negatives = [
  {
    t: "An Administrator reads nothing",
    d: "Timeline, entry detail and the audit endpoint all return 403 for an Administrator, because the role holds no clinical permission.",
    f: "test_phase3_adversarial_suite.py",
  },
  {
    t: "A Clinician without consent gets 404",
    d: "The route lets the role through, so the denial has to come from the query builder, and it has to be a 404.",
    f: "test_phase3_adversarial_suite.py",
  },
  {
    t: "A consent scoped to labs does not leak a note",
    d: "Granted through the real POST /consents route with step-up, not built by hand.",
    f: "test_phase3_adversarial_suite.py",
  },
  {
    t: "The audit table refuses UPDATE and DELETE",
    d: "Run as the application role. Postgres answers \"permission denied\".",
    f: "test_consent_audit_notifications_schema.py",
  },
  {
    t: "Revocation lands between building a query and running it",
    d: "The statement is built while consent is live, a second session revokes, and executing the statement returns nothing.",
    f: "test_architecture_regressions.py",
  },
];
---

<Chapter
  id="proof"
  n={17}
  title="The tests are written to fail when the filter is missing"
  lede="Pulse's risk is one question: did the consent filter apply to that query. A mocked database cannot answer it, so the tests do not use one."
  wide
>
  <div class="pr">
    <div class="pr__text">
      <p>
        The backend suite starts real PostgreSQL and Redis in containers (testcontainers) and runs {stats.backendTests} tests against
        them. Most are integration tests. Unit tests are kept for branchy logic that needs no database, such as permission
        resolution, duplicate scoring and consent expiry.
      </p>
      <p>
        Negative tests come first. A positive test, where a consented Clinician sees the entry, passes just as happily when
        the filter was never applied, because the entry comes back either way. These are the tests that matter most here.
      </p>
    </div>

    <div class="pr__table" role="region" aria-label="Test layers" tabindex="0">
      <table>
        <thead>
          <tr><th scope="col">Layer</th><th scope="col">Runs against</th><th scope="col">Size</th></tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row">Backend suite</th>
            <td>Real PostgreSQL and Redis, started by testcontainers</td>
            <td>{stats.backendTests} tests</td>
          </tr>
          <tr>
            <th scope="row">Browser suite, mocked</th>
            <td>Chromium with <code>/api/v1/**</code> stubbed</td>
            <td>{stats.e2eTests} tests in {stats.e2eSpecs} specs</td>
          </tr>
          <tr>
            <th scope="row">Live spine</th>
            <td>The full Compose stack through Caddy, nothing mocked</td>
            <td>{stats.liveSpecs} spec</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <div class="pipe" data-proof-pipeline>
    <div class="pipe__head">
      <h3>What CI runs on every pull request</h3>
      <button class="btn" type="button" data-replay>Replay the pipeline</button>
    </div>
    <p class="pipe__note">
      Four jobs run in parallel, from <a href={blob(".github/workflows/ci.yml")}>.github/workflows/ci.yml</a>. Steps tagged
      lint are the enforcement checks: each one fails the build on an absence that review tends to miss.
    </p>
    <ol class="lanes" role="list">
      {ciJobs.map((job) => (
        <li class="lane">
          <h4><code>{job.name}</code></h4>
          <p class="lane__note">{job.note}</p>
          <ol class="steps">
            {job.steps.map((s, i) => (
              <li class={`step step--${s.kind}`} style={`--i:${i}`}>
                <code>{s.cmd}</code>
                <span class="step__what">{s.what}</span>
                {(s.kind === "lint" || s.kind === "test") && <span class="step__tag">{s.kind}</span>}
              </li>
            ))}
          </ol>
        </li>
      ))}
    </ol>

    <div class="spine">
      <h4>What the live job exercises</h4>
      <ol class="spine__steps">
        {liveSpine.map((s, i) => (
          <li style={`--i:${i + 3}`}>{s}</li>
        ))}
      </ol>
      <p>
        The mocked suite cannot see the contract between frontend and backend: it once stayed green while every real
        consent grant failed for want of a password re-entry the form never sent. The live job exists because of that. See{" "}
        <a href={`${base}/guide/learnings`}>learnings</a>.
      </p>
    </div>
  </div>

  <div class="bite">
    <div class="bite__text">
      <h3>A bad router must fail the build</h3>
      <p>
        <a href={`${base}/guide/adr/0004-default-deny-route-authorization`}>ADR-0004</a> says every route declares a
        permission or an explicit public marker. The test that enforces it also proves it can fail: it mounts a router
        with one undeclared route on a throwaway app and asserts the check reports exactly that route. A coverage check
        that never fails would be indistinguishable from one that does not run.
      </p>
      <p>
        One route is on an explicit allowlist, the unauthenticated liveness probe <code>GET /api/v1/health</code>.
      </p>
    </div>
    <div class="bite__code">
      <CodeBlock code={badRouter} lang="python" file="backend/tests/_fixtures/bad_router.py" lines="10-15" />
      <CodeBlock code={biteTest} lang="python" file="backend/tests/test_route_coverage.py" lines="88-101" />
    </div>
  </div>

  <div class="neg">
    <h3>Five of the negative tests</h3>
    <ul class="neg__list">
      {negatives.map((n) => (
        <li>
          <p class="neg__t">{n.t}</p>
          <p class="neg__d">{n.d} <code>{n.f}</code></p>
        </li>
      ))}
    </ul>
    <div class="neg__code">
      <CodeBlock code={revokeTest} lang="python" file="backend/tests/test_architecture_regressions.py" lines="79-101" />
      <p class="neg__cap">
        The test in full. Nothing is cached: the revoker deletes the permission row, and the next execution of the
        query sees it gone. A statement already running when revocation commits is not interrupted, which{" "}
        <a href={`${base}/guide/adr/0016-transactional-audit-and-safe-identity-merges`}>ADR-0016</a> states plainly.
      </p>
    </div>
  </div>
</Chapter>

<style>
  .pr { display: grid; gap: 2rem; }
  @media (min-width: 1000px) { .pr { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 3rem; align-items: start; } }
  .pr__text p + p { margin-top: 1em; }
  .pr__table { overflow-x: auto; border: 1px solid var(--border); border-radius: var(--radius); background: var(--card); }
  table { border-collapse: collapse; width: 100%; font-size: 0.95rem; }
  th, td { text-align: left; padding: 0.75rem 1rem; border-bottom: 1px solid var(--border); vertical-align: top; }
  tbody tr:last-child > * { border-bottom: 0; }
  thead th { font-weight: 700; font-size: 0.85rem; color: var(--muted-foreground); }
  tbody th { font-weight: 500; white-space: nowrap; }
  td:last-child { white-space: nowrap; }
  @media (max-width: 640px) { td:last-child { white-space: normal; } }

  .pipe { margin-top: clamp(3rem, 6vw, 5rem); }
  .pipe__head { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between; }
  .pipe__head h3 { font-size: var(--step-2); }
  .pipe__note { margin-top: 0.6rem; color: var(--muted-foreground); max-width: 70ch; font-size: 0.97rem; }

  .lanes { list-style: none; margin: 1.75rem 0 0; padding: 0; display: grid; gap: 1.5rem; }
  @media (min-width: 700px) { .lanes { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .lanes { grid-template-columns: 1.5fr 1fr 0.9fr 1.1fr; gap: 1rem; } }
  .lane { min-width: 0; display: grid; align-content: start; gap: 0.35rem; }
  .lane h4 { font-size: 1rem; }
  .lane h4 code { background: none; border: 0; padding: 0; font-size: 1rem; font-weight: 700; }
  .lane__note { font-size: 0.85rem; color: var(--muted-foreground); margin-bottom: 0.5rem; }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.4rem; position: relative; }

  .step {
    display: grid;
    gap: 0.1rem;
    padding: 0.55rem 0.75rem 0.55rem 0.9rem;
    border: 1px solid var(--border);
    border-left: 1px solid var(--primary);
    border-radius: 10px;
    background: var(--primary-soft);
    position: relative;
    min-width: 0;
    transition: opacity 320ms var(--ease-out), background-color 320ms, border-left-color 320ms;
    transition-delay: calc(var(--i) * 110ms);
  }
  .step code { background: none; border: 0; padding: 0; font-size: 0.78rem; overflow-wrap: anywhere; }
  .step__what { font-size: 0.82rem; color: var(--muted-foreground); }
  .step__tag { position: absolute; top: 0.45rem; right: 0.6rem; font-size: 0.74rem; font-weight: 500; color: var(--primary); }
  .step--lint, .step--test { padding-right: 3.2rem; }

  /* Armed by script: steps start dim and light up in order. Without script they are all lit. */
  .pipe.is-armed .step { opacity: 0.4; background: var(--card); border-left-color: var(--border); }
  .pipe.is-armed.is-run .step { opacity: 1; background: var(--primary-soft); border-left-color: var(--primary); }

  .spine { margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border); display: grid; gap: 0.9rem; }
  .spine h4 { font-size: 1rem; }
  .spine__steps { list-style: none; counter-reset: s; margin: 0; padding: 0; display: grid; gap: 0.5rem; }
  @media (min-width: 700px) { .spine__steps { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .spine__steps { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
  .spine__steps li {
    counter-increment: s;
    display: grid;
    gap: 0.25rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--primary-soft);
    font-size: 0.9rem;
    transition: opacity 320ms var(--ease-out);
    transition-delay: calc(var(--i) * 110ms);
  }
  .spine__steps li::before { content: counter(s); font-weight: 700; color: var(--primary); font-size: 0.85rem; }
  .pipe.is-armed .spine__steps li { opacity: 0.4; }
  .pipe.is-armed.is-run .spine__steps li { opacity: 1; }
  .spine > p { color: var(--muted-foreground); font-size: 0.95rem; max-width: 70ch; }

  .bite { margin-top: clamp(3rem, 6vw, 5rem); display: grid; gap: 2rem; }
  @media (min-width: 1000px) { .bite { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 3rem; align-items: start; } }
  .bite__text h3, .neg h3 { font-size: var(--step-2); margin-bottom: 0.8rem; }
  .bite__text p + p { margin-top: 0.8em; }
  .bite__code { display: grid; gap: 1.25rem; min-width: 0; }

  .neg { margin-top: clamp(3rem, 6vw, 5rem); }
  .neg__list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0; max-width: 820px; }
  .neg__list li { padding: 0.9rem 0; border-top: 1px solid var(--border); }
  .neg__list li:last-child { border-bottom: 1px solid var(--border); }
  .neg__t { font-weight: 500; }
  .neg__d { color: var(--muted-foreground); font-size: 0.95rem; margin-top: 0.2rem; }
  .neg__code { margin-top: 2rem; max-width: 820px; }
  .neg__cap { margin-top: 0.9rem; color: var(--muted-foreground); font-size: 0.95rem; }
</style>

<script>
  import { reducedMotion } from "../scripts/motion";

  const pipe = document.querySelector<HTMLElement>("[data-proof-pipeline]");
  const replay = document.querySelector<HTMLButtonElement>("[data-replay]");
  if (pipe && replay && !reducedMotion()) {
    pipe.classList.add("is-armed");
    const run = () => {
      pipe.classList.remove("is-run");
      void pipe.offsetWidth;
      requestAnimationFrame(() => pipe.classList.add("is-run"));
    };
    new IntersectionObserver(
      (entries, io) => {
        if (entries.some((e) => e.isIntersecting)) {
          run();
          io.disconnect();
        }
      },
      { rootMargin: "0px 0px -25% 0px" },
    ).observe(pipe);
    replay.addEventListener("click", run);
  } else if (replay) {
    replay.hidden = true;
  }
</script>
